# Learnary environment template — copy to .env.local and fill in.
# NEVER commit real keys. NEXT_PUBLIC_* values are embedded in the browser
# bundle, so only publishable values may use that prefix.

# ---------------------------------------------------------------------------
# Supabase (client + server) — publishable values, safe in the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_API=sb_publishable_xxx_or_legacy_anon_jwt

# ---------------------------------------------------------------------------
# SEO / canonical origin (used by robots.js, sitemap.js, metadataBase)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://learnary.app

# ---------------------------------------------------------------------------
# Assistant service (server-only — NO NEXT_PUBLIC_ prefix, enforced by the
# `server-only` imports in src/server/ai/). Set in Vercel env vars.
# ---------------------------------------------------------------------------
LEARNARY_AI_ENABLED=false
LEARNARY_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
# Default budget when a prompt does not declare its own.
LEARNARY_AI_MAX_OUTPUT_TOKENS=1600
# Hard per-response ceiling: per-action budgets (roadmap uses 16k) are clamped
# to this, so a prompt can never exceed the deployment's intended spend.
LEARNARY_AI_MAX_OUTPUT_TOKENS_CAP=16384
LEARNARY_AI_DAILY_USER_UNITS=10
LEARNARY_AI_GLOBAL_DAILY_UNITS=500
LEARNARY_AI_MAX_BODY_BYTES=65536
LEARNARY_AI_PROVIDER_TIMEOUT_MS=30000
# Hard per-request timeout ceiling, kept under the route's 90 s maxDuration.
LEARNARY_AI_MAX_PROVIDER_TIMEOUT_MS=85000
# Deployment-wide spend ceiling in provider tokens per UTC day.
LEARNARY_AI_GLOBAL_DAILY_TOKENS=2000000
# Abuse control: fixed-window request limits.
LEARNARY_AI_IP_REQUESTS_PER_MINUTE=30
LEARNARY_AI_USER_REQUESTS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Supabase service key - REQUIRED for assistant quota accounting. Server-only:
# never prefix with NEXT_PUBLIC_, never ship to the
# browser. The Route Handler uses it ONLY to move quota counters after it has
# verified the caller's JWT; all user-data access still uses the publishable
# key + RLS. Without it, assistant requests fail closed with AI_MISCONFIGURED.
#
# Set exactly ONE of these (both are accepted; SUPABASE_SECRET_KEY wins if
# both are present):
#   SUPABASE_SECRET_KEY        — new-style key: Settings → API Keys → `sb_secret_...`
#   SUPABASE_SERVICE_ROLE_KEY  — legacy JWT from Settings → API Keys → Legacy: `eyJ...`
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
